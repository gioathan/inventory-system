<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.35.1" />
    <PackageReference Include="Grpc.Net.Client" Version="2.83.0" />
    <PackageReference Include="Grpc.Tools" Version="2.83.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- GrpcServices="Both" generates both the server base class (XxxBase) and the client
         stub (XxxClient) here, once — Catalog.Api/Inventory.Api implement the base class,
         ScanGateway.Api/Dashboard.Api call through the client stub, same generated types. -->
    <Protobuf Include="Protos\catalog.proto" GrpcServices="Both" />
    <Protobuf Include="Protos\inventory.proto" GrpcServices="Both" />
  </ItemGroup>

</Project>
